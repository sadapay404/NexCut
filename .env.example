# copy to .env and fill in — .env is gitignored
#
# gemini | groq | openai | stub
NEXCUT_PROVIDER=gemini

# the key for that provider
NEXCUT_API_KEY=your-key-here

# more keys, any mix of commas/newlines/spaces — tried in order after the two above:
# a refused or rate-limited key is skipped and the next one is used
NEXCUT_API_KEYS=

# max provider calls per extraction, so a long dead-key list cannot hang a run
NEXCUT_MAX_ATTEMPTS=12

# optional second key, tried after the first runs out
NEXCUT_BACKUP_KEY=

# models to try, best first. Leave blank to use the shipped list.
#   gemini: gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash
#   groq:   llama-3.3-70b-versatile,llama-3.1-8b-instant
NEXCUT_MODELS=

# only for openai-compatible gateways that are not groq/openai themselves
NEXCUT_OPENAI_BASE=

# seconds before a single model call is abandoned
NEXCUT_TIMEOUT=180

# some APIs (Groq behind Cloudflare) block the stdlib client signature
NEXCUT_USER_AGENT=

# Cloudflare Workers AI only: the account id from Workers AI -> Use REST API
NEXCUT_CF_ACCOUNT=

NEXCUT_PORT=8080
